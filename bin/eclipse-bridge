#!/usr/bin/env bash
# ==============================================================================
# ECLIPSE Chat Bridge Control CLI
# Manages the automated Google Docs -> Termux local execution bridge.
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WATCH_SCRIPT="${SCRIPT_DIR}/watch.py"
STATE_DIR="${ECLIPSE_BRIDGE_STATE:-/root/.local/state/eclipse-chat-bridge}"
LOG_FILE="${STATE_DIR}/watcher.log"
PID_FILE="${STATE_DIR}/watcher.pid"
PYTHON_BIN="${PYTHON_BIN:-python3}"

mkdir -p "${STATE_DIR}"

get_running_pid() {
  if [[ -f "${PID_FILE}" ]]; then
    local pid
    pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      echo "${pid}"
      return 0
    fi
  fi
  # Fallback to checking pgrep for watch.py
  local proc
  proc="$(pgrep -f "${WATCH_SCRIPT}" 2>/dev/null || true)"
  if [[ -n "${proc}" ]]; then
    echo "${proc}" | head -n 1
    return 0
  fi
  return 1
}

cmd_start() {
  local pid
  if pid="$(get_running_pid)"; then
    echo "ECLIPSE Chat Bridge is already running (PID: ${pid})."
    return 0
  fi

  echo "Starting ECLIPSE Chat Bridge daemon..."
  nohup "${PYTHON_BIN}" "${WATCH_SCRIPT}" "$@" >> "${LOG_FILE}" 2>&1 &
  local new_pid=$!
  echo "${new_pid}" > "${PID_FILE}"
  sleep 1

  if kill -0 "${new_pid}" 2>/dev/null; then
    echo "ECLIPSE Chat Bridge daemon started successfully (PID: ${new_pid})."
    echo "Logging to: ${LOG_FILE}"
  else
    echo "Failed to start ECLIPSE Chat Bridge daemon. Recent log entries:"
    tail -n 20 "${LOG_FILE}" 2>/dev/null || true
    return 1
  fi
}

cmd_stop() {
  local pid
  if ! pid="$(get_running_pid)"; then
    echo "ECLIPSE Chat Bridge is not running."
    rm -f "${PID_FILE}"
    return 0
  fi

  echo "Stopping ECLIPSE Chat Bridge daemon (PID: ${pid})..."
  kill "${pid}" 2>/dev/null || true
  local count=0
  while kill -0 "${pid}" 2>/dev/null; do
    sleep 0.5
    count=$((count + 1))
    if [[ ${count} -ge 10 ]]; then
      echo "Force stopping (SIGKILL)..."
      kill -9 "${pid}" 2>/dev/null || true
      break
    fi
  done
  rm -f "${PID_FILE}"
  echo "ECLIPSE Chat Bridge daemon stopped."
}

cmd_status() {
  local pid
  if pid="$(get_running_pid)"; then
    echo "Status: RUNNING (PID: ${pid})"
    echo "State Directory: ${STATE_DIR}"
    echo "Log File: ${LOG_FILE}"
    echo "Latest State Summary:"
    if [[ -f "${STATE_DIR}/requests.json" ]]; then
      "${PYTHON_BIN}" -c "
import json
try:
    with open('${STATE_DIR}/requests.json') as f:
        d = json.load(f)
    print(f'  Tracked Requests: {len(d)}')
    completed = sum(1 for v in d.values() if v.get('status') == 'completed')
    running = sum(1 for v in d.values() if v.get('status') == 'running')
    error = sum(1 for v in d.values() if v.get('status') == 'error')
    print(f'  Completed: {completed} | Running: {running} | Errors: {error}')
except Exception as e:
    print('  Could not parse requests.json:', e)
" 2>/dev/null || true
    fi
  else
    echo "Status: STOPPED"
    echo "State Directory: ${STATE_DIR}"
  fi
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start "$@"
}

cmd_logs() {
  if [[ ! -f "${LOG_FILE}" ]]; then
    echo "No log file found at ${LOG_FILE}."
    return 0
  fi
  if [[ "${1:-}" == "-f" ]]; then
    tail -f "${LOG_FILE}"
  else
    tail -n 50 "${LOG_FILE}"
  fi
}

cmd_run() {
  "${PYTHON_BIN}" "${WATCH_SCRIPT}" "$@"
}

cmd_test() {
  echo "Running unit test suite for ECLIPSE Chat Bridge..."
  cd "${SCRIPT_DIR}"
  "${PYTHON_BIN}" -m unittest -v test_watch.py
}

cmd_help() {
  cat << 'EOF'
Usage: eclipse-bridge <command> [options]

Commands:
  start [options]    Start the watcher daemon in the background
  stop               Stop the background watcher daemon
  restart [options]  Restart the watcher daemon
  status             Check status of the bridge daemon and processed requests
  logs [-f]          View recent log output (pass -f to follow)
  run [options]      Run the watcher in foreground mode
  test               Run the unit test suite
  help               Show this help message

Options passed to 'start' and 'run':
  --execution {auto,confirm}   Execute scripts automatically or prompt locally (default: auto)
  --interval SECONDS           Docs API revision polling interval (default: 5, min: 3)
  --doc-id GOOGLE_DOC_ID       Google Doc ID to monitor
  --no-sync-doc                Do not append execution results back to Google Doc
  --once                       Poll once, process pending requests, and exit

Environment Variables:
  ECLIPSE_DOC_ID               Default Google Doc ID
  ECLIPSE_CORE_DIR             Path to chat-run-docs directory containing chat_docs_core.py
  ECLIPSE_BRIDGE_STATE         Directory for requests.json, results, and logs
EOF
}

case "${1:-help}" in
  start)
    shift
    cmd_start "$@"
    ;;
  stop)
    cmd_stop
    ;;
  restart)
    shift
    cmd_restart "$@"
    ;;
  status)
    cmd_status
    ;;
  logs)
    shift
    cmd_logs "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  once)
    shift
    cmd_run --once "$@"
    ;;
  test)
    cmd_test
    ;;
  help|--help|-h)
    cmd_help
    ;;
  *)
    echo "Unknown command: $1" >&2
    cmd_help
    exit 1
    ;;
esac
