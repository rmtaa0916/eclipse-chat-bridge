#!/usr/bin/env bash
# ==============================================================================
# ECLIPSE Chat Bridge Control CLI & Interactive Dashboard
# Manages the automated Google Docs -> Termux local execution bridge.
# ==============================================================================

set -euo pipefail

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${REAL_SCRIPT}")/.." && pwd)"
WATCH_SCRIPT="${SCRIPT_DIR}/watch.py"
STATE_DIR="${ECLIPSE_BRIDGE_STATE:-/root/.local/state/eclipse-chat-bridge}"
LOG_FILE="${STATE_DIR}/watcher.log"
PID_FILE="${STATE_DIR}/watcher.pid"
PYTHON_BIN="${PYTHON_BIN:-python3}"
DOC_ID="${ECLIPSE_DOC_ID:-1N_TYeHUTexHaU2eiZ40hMWsaNNl-GaZJ-6H1MxHPPYM}"

mkdir -p "${STATE_DIR}"

# Color formatting if terminal supports it
if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  BOLD="$(tput bold || true)"
  GREEN="$(tput setaf 2 || true)"
  RED="$(tput setaf 1 || true)"
  CYAN="$(tput setaf 6 || true)"
  YELLOW="$(tput setaf 3 || true)"
  RESET="$(tput sgr0 || true)"
else
  BOLD=""
  GREEN=""
  RED=""
  CYAN=""
  YELLOW=""
  RESET=""
fi

get_running_pid() {
  if [[ -f "${PID_FILE}" ]]; then
    local pid
    pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      echo "${pid}"
      return 0
    else
      rm -f "${PID_FILE}"
    fi
  fi
  local proc
  proc="$(pgrep -f "${WATCH_SCRIPT}" 2>/dev/null || pgrep -f "python3.*watch\.py" 2>/dev/null || true)"
  if [[ -n "${proc}" ]]; then
    local active_pid
    active_pid="$(echo "${proc}" | head -n 1)"
    echo "${active_pid}" > "${PID_FILE}"
    echo "${active_pid}"
    return 0
  fi
  return 1
}

cmd_start() {
  local pid
  if pid="$(get_running_pid)"; then
    echo "${YELLOW}ECLIPSE Chat Bridge is already running (PID: ${pid}).${RESET}"
    return 0
  fi

  echo "Starting ECLIPSE Chat Bridge daemon..."
  nohup "${PYTHON_BIN}" "${WATCH_SCRIPT}" "$@" >> "${LOG_FILE}" 2>&1 &
  local new_pid=$!
  echo "${new_pid}" > "${PID_FILE}"
  sleep 1

  if kill -0 "${new_pid}" 2>/dev/null; then
    echo "${GREEN}✓ ECLIPSE Chat Bridge daemon started (PID: ${new_pid}).${RESET}"
    echo "Logging to: ${LOG_FILE}"
  else
    echo "${RED}✗ Failed to start ECLIPSE Chat Bridge daemon. Recent log:${RESET}"
    tail -n 20 "${LOG_FILE}" 2>/dev/null || true
    return 1
  fi
}

cmd_stop() {
  local pid
  if ! pid="$(get_running_pid)"; then
    echo "${YELLOW}ECLIPSE Chat Bridge is not running.${RESET}"
    rm -f "${PID_FILE}"
    return 0
  fi

  echo "Stopping ECLIPSE Chat Bridge daemon (PID: ${pid})..."
  kill "${pid}" 2>/dev/null || true
  local count=0
  while kill -0 "${pid}" 2>/dev/null; do
    sleep 0.5
    count=$((count + 1))
    if [[ ${count} -ge 10 ]]; then
      echo "Force stopping (SIGKILL)..."
      kill -9 "${pid}" 2>/dev/null || true
      break
    fi
  done
  rm -f "${PID_FILE}"
  echo "${GREEN}✓ ECLIPSE Chat Bridge daemon stopped.${RESET}"
}

cmd_status() {
  local pid
  if pid="$(get_running_pid)"; then
    echo "${BOLD}Status:${RESET} ${GREEN}RUNNING${RESET} (PID: ${pid})"
    echo "${BOLD}Doc ID:${RESET} ${CYAN}${DOC_ID}${RESET}"
    echo "${BOLD}State Directory:${RESET} ${STATE_DIR}"
    echo "${BOLD}Log File:${RESET} ${LOG_FILE}"
    if [[ -f "${STATE_DIR}/requests.json" ]]; then
      "${PYTHON_BIN}" -c "
import json
try:
    with open('${STATE_DIR}/requests.json') as f:
        d = json.load(f)
    print(f'Tracked Requests: {len(d)}')
    completed = sum(1 for v in d.values() if v.get('status') == 'completed')
    running = sum(1 for v in d.values() if v.get('status') == 'running')
    error = sum(1 for v in d.values() if v.get('status') == 'error')
    print(f'Completed: {completed} | Running: {running} | Errors: {error}')
    keys = list(d.keys())[-5:]
    if keys:
        print('Recent Requests:')
        for k in reversed(keys):
            st = d[k].get('status', 'unknown')
            print(f'  • {k} [{st}]')
except Exception as e:
    print('Could not parse requests.json:', e)
" 2>/dev/null || true
    fi
  else
    echo "${BOLD}Status:${RESET} ${RED}STOPPED${RESET}"
    echo "${BOLD}Doc ID:${RESET} ${CYAN}${DOC_ID}${RESET}"
    echo "${BOLD}State Directory:${RESET} ${STATE_DIR}"
    if [[ -f "${STATE_DIR}/requests.json" ]]; then
      "${PYTHON_BIN}" -c "
import json
try:
    with open('${STATE_DIR}/requests.json') as f:
        d = json.load(f)
    print(f'Tracked Requests: {len(d)}')
except Exception:
    pass
" 2>/dev/null || true
    fi
  fi
}

cmd_restart() {
  cmd_stop
  sleep 1
  cmd_start "$@"
}

cmd_logs() {
  if [[ ! -f "${LOG_FILE}" ]]; then
    echo "${YELLOW}No log file found at ${LOG_FILE}.${RESET}"
    return 0
  fi
  if [[ "${1:-}" == "-f" ]]; then
    echo "${CYAN}Streaming logs (Ctrl+C to stop)...${RESET}"
    tail -f "${LOG_FILE}"
  else
    tail -n 50 "${LOG_FILE}"
  fi
}

cmd_run() {
  "${PYTHON_BIN}" "${WATCH_SCRIPT}" "$@"
}

cmd_test() {
  echo "${BOLD}Running test suite for ECLIPSE Chat Bridge...${RESET}"
  cd "${SCRIPT_DIR}"
  PYTHONDONTWRITEBYTECODE=1 "${PYTHON_BIN}" -B -m unittest -v test_watch.py test_latest_response_slot.py test_bridge_ui.py test_result_reader.py test_context_snapshot.py test_priority_discovery.py
}

cmd_help() {
  cat << EOF
${BOLD}Usage:${RESET} BRIDGE [command] [options]

When called without commands, opens the interactive control menu.

${BOLD}Commands:${RESET}
  status             Check status of the bridge daemon and processed requests
  monitor            Open the live animated quantum bridge monitor
  start [options]    Start the watcher daemon in the background
  stop               Stop the background watcher daemon
  restart [options]  Restart the watcher daemon
  logs [-f]          View recent log output (pass -f to follow)
  run [options]      Run the watcher in foreground mode
  once               Poll once, process pending requests, and exit
  test               Run the automated unit test suite
  doc                Show the Google Doc URL and ID
  menu               Open the interactive dashboard menu
  help               Show this help message

${BOLD}Options for 'start' and 'run':${RESET}
  --execution {auto,confirm}   Auto execute or prompt locally (default: auto)
  --interval SECONDS           Revision polling interval (default: 5, min: 3)
  --doc-id GOOGLE_DOC_ID       Google Doc ID to monitor
  --no-sync-doc                Do not sync diagnostics to Google Doc

${BOLD}Environment Variables:${RESET}
  ECLIPSE_DOC_ID               Google Doc ID to monitor
  ECLIPSE_CORE_DIR             Path to directory containing chat_docs_core.py
  ECLIPSE_BRIDGE_STATE         Directory for requests.json, results, and logs
EOF
}

cmd_menu() {
  if [[ -f "${SCRIPT_DIR}/bridge_ui.py" ]]; then
    exec "${PYTHON_BIN}" "${SCRIPT_DIR}/bridge_ui.py" "$@"
  fi
  while true; do
    clear 2>/dev/null || echo "--------------------------------------------------"
    echo "${BOLD}================================================================${RESET}"
    echo "              ${CYAN}${BOLD}ECLIPSE CHAT BRIDGE DASHBOARD${RESET}"
    echo "${BOLD}================================================================${RESET}"
    local pid
    if pid="$(get_running_pid)"; then
      echo " ${BOLD}Bridge Daemon:${RESET}  ${GREEN}● RUNNING${RESET} (PID: ${pid})"
    else
      echo " ${BOLD}Bridge Daemon:${RESET}  ${RED}○ STOPPED${RESET}"
    fi
    echo " ${BOLD}Google Doc ID:${RESET}  ${CYAN}${DOC_ID}${RESET}"
    
    if [[ -f "${STATE_DIR}/requests.json" ]]; then
      "${PYTHON_BIN}" -c "
import json
try:
    with open('${STATE_DIR}/requests.json') as f:
        d = json.load(f)
    completed = sum(1 for v in d.values() if v.get('status') == 'completed')
    running = sum(1 for v in d.values() if v.get('status') == 'running')
    error = sum(1 for v in d.values() if v.get('status') == 'error')
    print(f' {BOLD}Requests Stats:{RESET} {completed} completed | {running} running | {error} errors (Total: {len(d)})')
    keys = list(d.keys())[-3:]
    if keys:
        print(f'\n {BOLD}Latest Requests:${RESET}')
        for k in reversed(keys):
            st = d[k].get('status', 'unknown')
            print(f'   • {k[:36]} [{st}]')
except Exception:
    pass
" 2>/dev/null || true
    fi
    echo ""
    echo "${BOLD}================================================================${RESET}"
    echo " [S] Status & History      [R] Restart Daemon     [A] Start Daemon"
    echo " [T] Stop Daemon           [L] Live Logs          [O] Run Once"
    echo " [U] Run Unit Tests        [D] Show Google Doc    [Q] Quit / Back"
    echo "${BOLD}================================================================${RESET}"
    read -r -p "Select option [S]: " choice || break
    case "${choice:-s}" in
      s|S)
        echo ""
        cmd_status
        echo ""
        read -r -p "Press [ENTER] to return to menu: " _ || true
        ;;
      r|R)
        echo ""
        cmd_restart
        echo ""
        read -r -p "Press [ENTER] to return to menu: " _ || true
        ;;
      a|A)
        echo ""
        cmd_start
        echo ""
        read -r -p "Press [ENTER] to return to menu: " _ || true
        ;;
      t|T)
        echo ""
        cmd_stop
        echo ""
        read -r -p "Press [ENTER] to return to menu: " _ || true
        ;;
      l|L)
        echo ""
        cmd_logs -f
        echo ""
        read -r -p "Press [ENTER] to return to menu: " _ || true
        ;;
      o|O)
        echo ""
        echo "Running single poll iteration..."
        cmd_run --once || true
        echo ""
        read -r -p "Press [ENTER] to return to menu: " _ || true
        ;;
      u|U)
        echo ""
        cmd_test || true
        echo ""
        read -r -p "Press [ENTER] to return to menu: " _ || true
        ;;
      d|D)
        echo ""
        echo "${BOLD}Google Doc URL:${RESET}"
        echo "https://docs.google.com/document/d/${DOC_ID}/edit"
        echo ""
        read -r -p "Press [ENTER] to return to menu: " _ || true
        ;;
      q|Q|b|B|exit)
        echo "Exiting ECLIPSE Chat Bridge menu."
        break
        ;;
      *)
        echo "Unknown option: ${choice}"
        sleep 1
        ;;
    esac
  done
}

# Dispatcher
if [[ $# -eq 0 ]]; then
  if [[ -t 0 ]]; then
    cmd_menu
  else
    cmd_status
  fi
  exit 0
fi

case "${1}" in
  monitor|-m|--monitor)
    shift
    exec "${PYTHON_BIN}" "${SCRIPT_DIR}/bridge_ui.py" monitor "$@"
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  start)
    shift
    cmd_start "$@"
    ;;
  stop)
    shift
    cmd_stop
    ;;
  restart)
    shift
    cmd_restart "$@"
    ;;
  logs)
    shift
    cmd_logs "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  once)
    shift
    cmd_run --once "$@"
    ;;
  test)
    cmd_test
    ;;
  doc|url)
    echo "https://docs.google.com/document/d/${DOC_ID}/edit"
    ;;
  menu)
    cmd_menu
    ;;
  help|--help|-h)
    cmd_help
    ;;
  *)
    echo "Unknown command: $1" >&2
    cmd_help
    exit 1
    ;;
esac
